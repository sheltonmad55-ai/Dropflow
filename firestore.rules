rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth()
        && (request.auth.token.admin == true
          || request.auth.token.email == 'sheltonmad55@gmail.com');
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function ownsNewDocument() {
      return isAuth()
        && request.resource.data.user_id == request.auth.uid;
    }

    function ownsExistingDocument() {
      return isAuth()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
    }

    function ownsDocument() {
      return isAuth() && resource.data.user_id == request.auth.uid;
    }

    // Boot connectivity probe.
    match /test/connection {
      allow read: if true;
    }

    // Profiles are keyed by the Firebase Auth UID.
    match /profiles/{profileId} {
      allow get: if isValidId(profileId)
        && (isAdmin() || (isAuth() && request.auth.uid == profileId));
      allow list: if isAdmin();
      allow create, update: if isValidId(profileId)
        && isAuth()
        && (request.auth.uid == profileId || isAdmin())
        && request.resource.data.id == profileId;
      allow delete: if isAdmin() && isValidId(profileId);
    }

    // User-owned financial collections. The data model is intentionally not
    // hard-coded here: older documents and new optional fields must not make
    // the whole Firestore batch fail. Ownership remains mandatory.
    match /caixinhas/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /vendas/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /despesas/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /produtos/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /fornecedores/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /zonas_entrega/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /campanhas/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /despesas_recorrentes/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /meta_items/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /contas_bancarias/{id} {
      allow get, list: if ownsDocument();
      allow create: if isValidId(id) && ownsNewDocument();
      allow update: if isValidId(id) && ownsExistingDocument();
      allow delete: if isValidId(id) && ownsDocument();
    }

    match /admin_logs/{id} {
      allow get, list, write: if isAdmin() && isValidId(id);
    }

    match /broadcasts/{id} {
      allow get, list: if isAuth();
      allow write: if isAdmin() && isValidId(id);
    }

    match /relatorios/{id} {
      allow get, list: if isAuth()
        && (isAdmin() || resource.data.user_id == request.auth.uid);
      allow create, update: if isValidId(id)
        && (isAdmin() || ownsNewDocument());
      allow delete: if isAdmin()
        || (isValidId(id) && ownsDocument());
    }
  }
}
